# Sentry Configuration
SENTRY_AUTH_TOKEN=your_sentry_auth_token
SENTRY_ORG_SLUG=your_org_slug
SENTRY_PROJECT_SLUG=your_project_slug

# UptimeRobot Configuration
UPTIMEROBOT_API_KEY=your_uptimerobot_api_key

# Stripe Billing Configuration
# Copy this file to .env and fill in real values. Nothing usable is provided
# here on purpose: a non-empty placeholder would be accepted at runtime.
# Billing is enabled only when STRIPE_SECRET_KEY is set.
# - Secret API key from the Stripe dashboard (starts with the test or live secret prefix).
# - Signing secret of the billing webhook endpoint (starts with the webhook secret prefix).
# - Price ids of the three active plan tiers, copied from the Stripe dashboard.
#   Each is required: if one is left unset, checkout and plan changes fail
#   closed with an error naming the missing variable (NOC-318).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_ADVANCED=
STRIPE_PRICE_WHITE_GLOVE=

# API Configuration
API_PORT=3001
BASE_URL=http://localhost:3001

# Engine Configuration
POLL_INTERVAL_SEC=60
DB_PATH=./data/nightlamp.db
PLAYBOOK_DIR=./playbook

# X/Twitter OAuth Configuration
X_CLIENT_ID=your_x_client_id
X_CLIENT_SECRET=your_x_client_secret
X_CALLBACK_URL=http://localhost:3001/api/x/callback

# X/Twitter Launch Posting
X_POST_ON_STARTUP=false
X_LAUNCH_THREAD_FILE=./docs/marketing/build-in-public-content.md

# Frontend Configuration (copy to frontend/.env.local)
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001