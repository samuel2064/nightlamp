    "jwks-rsa": "^3.1.0",
    "moment": "^2.29.4",
    "node-cron": "^3.0.3",
    "pg": "^8.11.3",
    "pino": "^8.16.2",
    "pino-pretty": "^10.2.3",
    "socket.io": "^4.7.2",
    "sql.js": "^1.8.0",
    "stripe": "^14.9.0",
    "uuid": "^9.0.1",
    "ws": "^8.14.2",
    "yaml": "^2.3.4"
  }
}

