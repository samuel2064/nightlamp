{
  "name": "nightlamp",
  "version": "0.1.0",
  "description": "Nightlamp monitors AI-built and no-code apps",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "npx ts-node src/index.ts",
    "test": "npx mocha --require ts-node/register --timeout 10000 \"src/test/*.test.ts\"",
    "test:staging-provision": "node --test scripts/provision-flyby-staging.test.mjs scripts/provision-flyby-staging.integration.test.mjs",
    "stripe:catalogue:dry-run": "npx ts-node scripts/stripe-catalogue-dry-run.ts",
    "cleanup:verification-teams": "npx ts-node scripts/cleanup-verification-teams.ts",
    "smoke": "node dist/test-run.js",
    "clean": "rm -rf dist data playbook"
  },
  "keywords": [
    "monitoring",
    "health-checks",
    "sentry",
    "uptimerobot"
  ],
  "author": "Nightlamp",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@types/axios": "^0.9.36",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.8",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "@types/yaml": "^1.9.4",
    "jest": "^29.7.0",
    "mocha": "^10.2.0",
    "nock": "^13.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@prisma/client": "^5.7.0",
    "@slack/web-api": "^6.11.0",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.2.2",
    "cloudevents": "^7.0.1",
    "crypto": "^1.0.1",
    "csv-parse": "^5.5.3",
    "date-fns": "^2.30.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "fast-json-stable-stringify": "^2.1.0",
    "fs": "^0.0.1-security",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
